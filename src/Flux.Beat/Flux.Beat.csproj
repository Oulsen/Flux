<Project Sdk="Microsoft.NET.Sdk">

  <!-- No Windows APIs here: the listener is BCL sockets and arithmetic, so the
       beat grid stays testable on any runner. The Windows-only concerns (timer
       resolution, WASAPI, WinRT MIDI) live in the host and in Flux.Audio. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
  </ItemGroup>

</Project>
