<Project Sdk="Microsoft.NET.Sdk">

  <!-- A library, not a web SDK project. The host executable is Flux.App from
       Phase 1 to release - later phases change what that process hosts, never
       which executable runs - so the ASP.NET Core bits arrive as a framework
       reference rather than by making this a second entry point. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The origin check is internal rather than public: it is the socket's one
       security gate, and the tests pin its behaviour without it becoming API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Flux.Web.Server.Tests" />
  </ItemGroup>

  <!-- The contract and not Flux.Audio itself, which is net10.0-windows and
       therefore unreferenceable from here. That is the point of the split: the
       device list and the spectrum arrive as shapes, and the WASAPI stack behind
       them stays where it belongs. A host with no audio registers neither
       interface and this project serves a page regardless. -->
  <ItemGroup>
    <ProjectReference Include="..\Flux.Audio.Contract\Flux.Audio.Contract.csproj" />
    <ProjectReference Include="..\Flux.Beat\Flux.Beat.csproj" />
  </ItemGroup>

  <!-- Flux.Hue directly, and no contract project beside it, which is the payoff
       for keeping that project on net10.0. The bridge is HTTP and UDP; the only
       Windows-bound call in it is DPAPI, annotated at its own class rather than
       pinned to the assembly. So the pairing screen reads the same types the
       bridge service holds, and there is no second assembly to keep in step. -->
  <ItemGroup>
    <ProjectReference Include="..\Flux.Hue\Flux.Hue.csproj" />
  </ItemGroup>

  <!-- wwwroot is Vite's output, not source: it is gitignored and produced by
       `npm run build` in Flux.Web.Frontend before `dotnet build`. The glob is
       conditional because a fresh clone has no wwwroot yet, and a missing folder
       must not fail the build - MapFluxWeb says so at startup instead. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\wwwroot')">
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
