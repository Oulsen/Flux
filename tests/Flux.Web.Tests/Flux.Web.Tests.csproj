<Project Sdk="Microsoft.NET.Sdk">

  <!-- xunit.v3 runs on Microsoft.Testing.Platform: the test project is its own
       executable rather than a library a runner loads, so it needs OutputType
       Exe. The runner selection itself lives in global.json, which the .NET 10
       SDK reads to decide against the retired VSTest bridge. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <!-- Named rather than inherited from the project reference: these tests
       construct WebSockets and loggers directly, so the dependency is theirs. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Flux.Web\Flux.Web.csproj" />
  </ItemGroup>

</Project>
